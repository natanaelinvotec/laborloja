rules_version = '2';
// Leitura pública (o site precisa ler). Escrita só para os e-mails administradores.
// Para adicionar outra pessoa ao painel, inclua o e-mail na lista abaixo
// E em assets/js/firebase-config.js (emailsAdmin).
service cloud.firestore {
  match /databases/{database}/documents {
    function ehAdmin() {
      return request.auth != null
        && request.auth.token.email in ['marcelo.teruo.mts@gmail.com'];
    }
    // Todo o conteúdo do site (textos, produtos, categorias, páginas)
    match /conteudo/{doc} {
      allow read: if true;
      allow write: if ehAdmin();
    }
    // Fotos e PDFs enviados pelo painel, divididos em partes
    match /arquivos/{id}/partes/{parte} {
      allow read: if true;
      allow write: if ehAdmin()
        && request.resource.data.d is string
        && request.resource.data.d.size() <= 800000;
    }
  }
}
